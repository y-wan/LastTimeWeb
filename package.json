{
  "name": "last-time-pwa",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:cjk && tsc -b && vite build && node scripts/verify-build-assets.mjs",
    "check:cjk": "node scripts/check-cjk.mjs",
    "check:hygiene": "node scripts/check-repository-hygiene.mjs",
    "typecheck": "tsc -b --pretty false",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "lint": "eslint . && npm run check:cjk && npm run check:hygiene",
    "test": "vitest run",
    "test:layout": "playwright test e2e/palette-layout.spec.ts",
    "test:install-metadata": "playwright test e2e/install-metadata.spec.ts",
    "docs:screenshots": "playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.22.0",
    "@material-symbols/svg-400": "^0.47.2",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^1.1.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.2",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.1"
  }
}
