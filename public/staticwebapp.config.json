{
  "routes": [
    {
      "route": "/",
      "headers": {
        "Cache-Control": "no-cache, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/manifest.*.webmanifest",
      "headers": {
        "Cache-Control": "no-cache, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/workbox-*.js",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/apple-touch-icon-20260919.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/sw.js",
      "/workbox-*.js",
      "/manifest.*.webmanifest",
      "/*.png",
      "/*.svg"
    ]
  }
}
